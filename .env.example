# Salin jadi .env lalu isi. Jangan commit .env.

# Token bot Telegram (dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat id penerima notifikasi (bukan username — chat id numerik, bisa dari @userinfobot)
TELEGRAM_CHAT_ID=

# Mode ekstraksi untuk semua target: "requests" (halaman statis) atau "playwright" (JS-rendered)
# Bisa di-override per target di targets.yaml
DEFAULT_FETCH_MODE=requests
